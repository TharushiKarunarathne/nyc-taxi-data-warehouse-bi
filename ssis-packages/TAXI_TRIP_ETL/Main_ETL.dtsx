      DTS:DTSID="{87F20F0A-4D4C-452B-8786-518298203941}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AB05AAEA-B3C5-42C0-9C5C-100504F0C7EA}"
          SQLTask:SqlStatementSource="DELETE FROM DimDate;&#xA;&#xA;WITH d AS&#xA;(&#xA;    SELECT CAST('2018-01-01' AS DATE) AS dt&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, dt)&#xA;    FROM d&#xA;    WHERE dt &lt; '2018-12-31'&#xA;)&#xA;INSERT INTO DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    DayNumber,&#xA;    MonthNumber,&#xA;    MonthName,&#xA;    QuarterNumber,&#xA;    YearNumber,&#xA;    DayOfWeekNumber,&#xA;    DayOfWeekName&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(VARCHAR(8), dt, 112)) AS DateKey,&#xA;    dt,&#xA;    DAY(dt),&#xA;    MONTH(dt),&#xA;    DATENAME(MONTH, dt),&#xA;    DATEPART(QUARTER, dt),&#xA;    YEAR(dt),&#xA;    DATEPART(WEEKDAY, dt),&#xA;    DATENAME(WEEKDAY, dt)&#xA;FROM d&#xA;OPTION (MAXRECURSION 366);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
