    <DTS:Executable
      DTS:refId="Package\Update FactTrip Complete Time"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{318EC57B-520A-4941-B99D-F085A25078A3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update FactTrip Complete Time"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{97366DBE-23C8-409E-AA11-8FD0228AD5E1}"
          SQLTask:SqlStatementSource="UPDATE f&#xA;SET f.accm_txn_complete_time = s.accm_txn_complete_time&#xA;FROM dbo.FactTrip f&#xA;INNER JOIN TAXI_TRIP_DATA_Staging.dbo.StgFactTripCompletionUpdate s&#xA;    ON f.TripID = s.TripID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update FactTrip Process Hours"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{35978137-6B82-4065-8A56-45E8DBFE0034}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update FactTrip Process Hours"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{97366DBE-23C8-409E-AA11-8FD0228AD5E1}"
          SQLTask:SqlStatementSource="UPDATE dbo.FactTrip&#xA;SET txn_process_time_hours =&#xA;    DATEDIFF(HOUR, accm_txn_create_time, accm_txn_complete_time)&#xA;WHERE accm_txn_create_time IS NOT NULL&#xA;  AND accm_txn_complete_time IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
